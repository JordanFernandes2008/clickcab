{
  "buildCommand": "",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/account/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/account/",
      "destination": "https://clickcab-portals.vercel.app/index.html"
    },
    {
      "source": "/account/:path*",
      "destination": "https://clickcab-portals.vercel.app/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/account",
      "destination": "/account/",
      "permanent": true
    }
  ]
}
